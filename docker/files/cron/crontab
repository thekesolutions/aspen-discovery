## -->  Crontab for Docker


# * * * * *  command to execute
# │ │ │ │ │
# │ │ │ │ └───── day of week (0 - 6)
# │ │ │ │        (0 to 6 are Sunday to Saturday, or use names (Sun,Mon,Tue,Wed,Thu,Fri,Sat); 7 is Sunday, the same as 0)
# │ │ │ └────────── month (1 - 12)
# │ │ └─────────────── day of month (1 - 31)
# │ └──────────────────── hour (0 - 23)
# └───────────────────────── min (0 - 59)
## taken from https://en.wikipedia.org/wiki/Cron

# This file is installed with `crontab -u root`, so jobs get cron's default PATH
# (/usr/bin:/bin), not the one in /etc/crontab. runuser lives in /usr/sbin.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin


#   Indexing Tasks 
7 3 * * *   sudo -u www-data    php /usr/local/aspen-discovery/code/web/cron/createSitemaps.php {sitename} >/proc/1/fd/1 2>/proc/1/fd/2
*/5 * * * * sudo -u www-data    php /usr/local/aspen-discovery/docker/files/cron/checkBackgroundProcessesDocker.php {sitename} >/proc/1/fd/1 2>/proc/1/fd/2

#   Regular extracts that don't need to run continuously 
0 2 * * *   cd /usr/local/aspen-discovery/code/oai_indexer && runuser -u www-data -- java -jar oai_indexer.jar {sitename} >/proc/1/fd/1 2>/proc/1/fd/2
0 2 * * *   cd /usr/local/aspen-discovery/code/reindexer && runuser -u www-data -- java -jar reindexer.jar {sitename} nightly >/proc/1/fd/1 2>/proc/1/fd/2

#   New York Times Best seller Lists Updating 
15 7 * * 5  sudo -u www-data    php /usr/local/aspen-discovery/code/web/cron/updateNYTLists.php {sitename} >/proc/1/fd/1 2>/proc/1/fd/2


