# Aspen Discovery Docker environment
#
# Copy this file to .env next to docker-compose.yml. Every variable is optional:
# a commented-out (or empty) variable uses the default shown, so Aspen starts
# even with this file unchanged. Uncomment a line only to change its value.
# See docker/README.md for what each variable does and when changes apply.

# =============================================================================
# RECOMMENDED TO CHANGE
# =============================================================================
# Public address users reach Aspen at
#URL=http://localhost:85
#TITLE=Aspen Discovery
#LIBRARY=Test Library
#TZ=UTC

# Passwords: the defaults are publicly known, change them before going live.
# ASPEN_ADMIN_PASSWORD and DATABASE_ROOT_PASSWORD only apply on first start.
#ASPEN_ADMIN_PASSWORD=aspenPass123
#DATABASE_PASSWORD=aspenpasswd
#DATABASE_ROOT_PASSWORD=password

# =============================================================================
# ASPEN SETTINGS
# =============================================================================
#SITE_NAME=aspen
#SUPPORTING_COMPANY=ByWater Solutions
# Host directory for the instance's conf, data, logs and database
#ASPEN_HOME=./aspen
# UID that owns files in ASPEN_HOME (use your own, e.g. from `id -u`); unset keeps www-data
#LOCAL_USER_ID=1000
#DEBUG=false

# =============================================================================
# DATABASE SETTINGS
# =============================================================================
#DATABASE_HOST=db
#DATABASE_PORT=3306
#DATABASE_NAME=aspen
#DATABASE_USER=aspenusr
#DATABASE_SSL_MODE=DISABLED

# =============================================================================
# SERVICES
# =============================================================================
#SOLR_HOST=solr
#SOLR_PORT=8983
#PHP_FPM_HOST=backend
#PHP_FPM_PORT=9000

# =============================================================================
# DOCKER IMAGES
# =============================================================================
#BACKEND_IMAGE_TAG=aspendiscovery/aspen
#SOLR_IMAGE_TAG=aspendiscovery/solr
#MARIADB_IMAGE=mariadb:10.5
#TUNNEL_IMAGE_TAG=aspendiscovery/tunnel

# =============================================================================
# MYSQL TUNNEL (only with docker-compose.tunnel.yml, for a remote ILS database)
# =============================================================================
# All of these are required when the tunnel is used
#TUNNEL_LOCAL_PORT=
#TUNNEL_REMOTE_HOST=
#TUNNEL_REMOTE_PORT=
#TUNNEL_JUMP_USER=
#TUNNEL_JUMP_SERVER=
