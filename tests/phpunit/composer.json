{
    "name": "aspen-discovery/test-suite",
    "description": "Comprehensive test suite for Aspen Discovery",
    "type": "project",
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpunit/php-code-coverage": "^10.1",
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Tests\\": "src/",
            "Tests\\Unit\\": "tests/unit/",
            "Tests\\Integration\\": "tests/integration/",
            "Tests\\Functional\\": "tests/functional/",
            "Tests\\Performance\\": "tests/performance/"
        }
    },
    "autoload-dev": {
        "files": [
            "src/AspenTestCase.php",
            "src/DatabaseTestCase.php",
            "src/TestDataFactory.php"
        ]
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "test:unit": "phpunit --configuration phpunit.xml --testsuite=unit",
        "test:integration": "phpunit --configuration phpunit.xml --testsuite=integration", 
        "test:functional": "phpunit --configuration phpunit.xml --testsuite=functional",
        "test:performance": "phpunit --configuration phpunit.xml --testsuite=performance",
        "test:coverage": "phpunit --configuration phpunit.xml --coverage-html=logs/coverage",
        "test:coverage-text": "phpunit --configuration phpunit.xml --coverage-text",
        "clean": "rm -rf logs/* vendor/"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}